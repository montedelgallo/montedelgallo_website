{
  "ci": {
    "collect": {
      "startServerCommand": "python3 script/serve-built-site.py .check-site 8124",
      "startServerReadyPattern": "listening",
      "url": [
        "http://127.0.0.1:8124/",
        "http://127.0.0.1:8124/projects/activecanvas-rails-cms-engine/",
        "http://127.0.0.1:8124/blog/get-ready-for-your-next-react-job-interview/",
        "http://127.0.0.1:8124/contact/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
